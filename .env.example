# Server Port (Railway sets this automatically)
PORT=3000

# Owner Master Password (Required for editing/managing tasks)
ADMIN_PASSWORD=change_this_to_your_secret_password

# Telegram Bot Integration (Optional)
BOT_TOKEN=8867143504:AAF...
CHANNEL_ID=-1001234567890

# Railway Volume Mount Path for Persistent Storage (Set on Railway Dashboard)
RAILWAY_VOLUME_MOUNT_PATH=/data
